RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block Bad Bots & Cloning Tools (e.g. HTTrack)
RewriteCond %{HTTP_USER_AGENT} (httrack|wget|curl|offline\ explorer|teleport\ pro|webcopier|webstripper|site-sucker|grabber|extractor|spider|crawler) [NC]
RewriteRule .* - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L]